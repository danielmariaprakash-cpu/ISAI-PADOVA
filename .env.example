# Copy to .env  (everything is optional — the app runs without any of this)
PORT=3000
OWNER_EMAIL=isai.padova@gmail.com

# Login-alert e-mails via Gmail: create an "App password" at myaccount.google.com/apppasswords (needs 2-step verification)
SMTP_USER=isai.padova@gmail.com
SMTP_PASS=

# Google Drive sync: install "Google Drive for desktop", then point to a folder inside it, e.g.
# DRIVE_DIR=G:\My Drive\ISAI-Padova        (Windows)
# DRIVE_DIR=/Users/you/Google Drive/My Drive/ISAI-Padova   (Mac)
DRIVE_DIR=

# Only used on the very first start
ADMIN_INITIAL_PASSWORD=insit1947@2026
# Set to 1 when running behind a reverse proxy / hosting platform (to read the real visitor IP)
TRUST_PROXY=0
